/* ===============================
   OHM MODAL
================================= */

.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.7);
    justify-content:center;
    align-items:center;
    z-index:9999;
}

.modal-content{
    width:90%;
    max-width:500px;
    background:#1b263b;
    border-radius:20px;
    padding:30px;
    border:1px solid rgba(255,255,255,.08);
    position:relative;
    animation:fadeIn .3s ease;
}

.modal-content h2{
    margin-bottom:20px;
    color:#00c8ff;
}

.modal-content label{
    display:block;
    margin-top:15px;
    margin-bottom:6px;
}

.modal-content input{
    width:100%;
    padding:12px;
    border:none;
    border-radius:10px;
    background:#0f172a;
    color:#fff;
    font-size:16px;
}

.close{
    position:absolute;
    right:20px;
    top:15px;
    font-size:30px;
    cursor:pointer;
    color:#ffffff;
}

#ohmResult{
    margin-top:20px;
    color:#00c8ff;
    text-align:center;
}

@keyframes fadeIn{
    from{
        opacity:0;
        transform:scale(.9);
    }
    to{
        opacity:1;
        transform:scale(1);
    }
}
#ohmResult{

margin-top:20px;
padding:15px;
background:#0f172a;
border-radius:12px;
font-size:18px;
line-height:1.7;

}

#resetOhm{

margin-top:10px;
background:#ff5252;

}

#resetOhm:hover{

background:#ff3333;

}

.result-box {
    margin-top: 15px;
    padding: 12px;
    border-radius: 8px;
    background-color: rgba(0, 212, 255, 0.1);
    border: 1px solid #00d4ff;
    color: #ffffff;
    font-size: 0.95rem;
    line-height: 1.5;
}

.result-box.error {
    background-color: rgba(255, 82, 82, 0.1);
    border-color: #ff5252;
    color: #ff5252;
}

.result-box strong {
    color: #00d4ff;
}
